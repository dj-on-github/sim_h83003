; ====================================================================
; Identified code
; ====================================================================
read_serial_data_byte    = H'00044C     ; reads RDR0 or RDR1 depending on bit 1 of H'FFFD1C, then clears RDRF in the matching SSR
send_serial_data_byte    = H'000472     ; sends the byte in R6L on the channel bit 1 of H'FFFD1C selects, spinning on TDRE at H'00047E or H'00048C first
serial_clear_rx_errors   = H'0004EE     ; returns R6=1 when SSR's error bits (ORER|FER|PER, H'38) are clear; otherwise reads a byte to drain RDR, clears those bits, zeroes H'FFFD1E and returns R6=0
get_rx_data_full_bit     = H'00053C     ; spins until RDRF is set, servicing errors through H'00049A meanwhile, then reads RDR, clears RDRF and returns the received BYTE in R6L — not a bit
get_sci_rx_ready_bit     = H'000576     ; returns SSR bit 6 (RDRF, H'40) for the channel CHAN_SELECTION picks, zero-extended into R6
get_sci_tx_ready_bit     = H'000590     ; returns SSR bit 7 (TDRE, H'80) for the channel CHAN_SELECTION picks, zero-extended into R6
fp_multiply              = H'20046C
fp_add                   = H'200608
fp_to_int                = H'2006C8
fp_int_to_float          = H'20070C
fp_normalise_loop        = H'20071E     ; the loop the machine spends most of its time in
adc_start_conversion     = H'20083E
adc_get_result           = H'20084A
adc_convert_polled       = H'200860
adc_result_jumptable     = H'2008B2
adc_start_channel        = H'200914
adc_channel_jumptable    = H'200934
adc_start_ch0_ch4        = H'200954
adc_start_ch1_ch5        = H'200960
adc_start_ch2_ch6        = H'20096C
adc_start_ch3_ch7        = H'200978
fill_table_11A6E8        = H'20651C
config_flash_program     = H'208A5C     ; programs the config block, writing the H'A5 marker last
adc_prime_an4_an6        = H'2091F0     ; runs once, from analog_input_init; not on the polling path
an4_release_event        = H'209262
an6_release_event        = H'209286
an4_press_handler        = H'2092AA
an6_press_handler        = H'209326
adc_sample_an4           = H'209C44     ; live path: converts AN4, stores it, counts samples >= H'4C
adc_sample_an6           = H'209C96     ; live path: converts adc_current_channel, window H'4C-H'96
input_scan               = H'209E48     ; polls the port bits and H'080000 into input_flags
analog_input_init        = H'20A030     ; sets the P4 drive bits, then primes AN4/AN6 once
touch_calibration_load   = H'210652     ; copies the four calibration constants from flash into RAM
touch_calibration_apply  = H'210FB4     ; touch_x_pixels = round(touch_x_raw * x_scale + x_offset), and likewise for Y

; ====================================================================
; Identified data
; ====================================================================
sci0_rx_payload          = H'0203D4     ; payload bytes of the frame being received
sci0_frame_len           = H'020886     ; expected length of the current frame
sci0_rx_state            = H'02089E     ; receive state machine
lcd_frame_buffer         = H'040000     ; LCD frame buffer, 320x240 at 2bpp, MSB first (H'4B00 bytes)
digital_inputs           = H'080000     ; external byte of digital inputs, polled by input_scan
mode_114DC6              = H'114DC6     ; bit 7 gates the AN6 window test
latch_114DD7             = H'114DD7     ; per-handler once-only latch
adc_results              = H'11A251     ; latest A/D conversion results, indexed by channel
table_11A6E8             = H'11A6E8     ; table filled by fill_table_11A6E8
touch_x_sample           = H'11A80C     ; X sample, copied to touch_x_raw when a contact is accepted
touch_y_sample           = H'11A80D     ; Y sample, copied to touch_y_raw
an4_over_count           = H'11A814     ; consecutive AN4 samples at or above H'4C, capped at H'C8
an4_under_count          = H'11A815     ; consecutive samples below H'4C; at 8, an4_release_event runs
an6_in_window_count      = H'11A816     ; consecutive AN6 samples inside H'4C-H'96, capped at H'C8
an6_out_count            = H'11A817
adc_current_channel      = H'11A818     ; channel being converted
adc_next_channel         = H'11A819     ; channel to convert next
touch_cal_x_scale        = H'11A87E     ; RAM copy of flash_cal_x_scale, = 1.325967
touch_cal_y_scale        = H'11A882     ; RAM copy of flash_cal_y_scale, = 1.006289
touch_cal_x_offset       = H'11A886     ; RAM copy of flash_cal_x_offset, = 0.720993
touch_cal_y_offset       = H'11A88A     ; RAM copy of flash_cal_y_offset, = -0.757862
touch_x_pixels           = H'11B102     ; touch X in screen pixels, 0-320
touch_y_pixels           = H'11B104     ; touch Y in screen pixels, 0-240
sci0_command_table       = H'2155B4     ; 15-entry SCI0 command dispatch table
sci0_check_byte          = H'216662     ; frame check byte
config_block             = H'57FF80     ; configuration block in the data flash
config_valid_marker      = H'57FF81     ; H'A5 when the block is valid; anything else falls back to defaults
flash_cal_x_scale        = H'57FFA0     ; per-machine touch calibration, big-endian IEEE-754 singles
flash_cal_y_scale        = H'57FFA4
flash_cal_x_offset       = H'57FFA8
flash_cal_y_offset       = H'57FFAC
firmware_version_string  = H'57FFB0     ; firmware version, copied here from H'200100 when programmed
CHAN_SELECTION           = H'FFFD1C     ; bit 1 picks SCI1 over SCI0 for read_serial_data_byte and send_serial_data_byte; 76 references, other bits set and cleared through ER6
mode_FFFEC0              = H'FFFEC0     ; must be 1 for an4_press_handler to act; 0 in normal running
input_flags              = H'FFFEC1     ; digital inputs packed by input_scan; bit 5 gates an4_press
touch_x_raw              = H'FFFED9     ; raw X the calibration is applied to
touch_y_raw              = H'FFFEDA     ; raw Y the calibration is applied to
an4_sample               = H'FFFEF0     ; latest AN4 sample; a shadow, not the coordinate — the touch position the UI uses is touch_x_raw
an6_sample               = H'FFFEF1     ; latest AN6 sample; likewise a shadow of touch_y_raw
an4_an6_drive_flags      = H'FFFEF7     ; bits 1 and 2, set and cleared around the AN4 and AN6 samples

